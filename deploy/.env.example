# PostHog hobby deploy env — EXAMPLE ONLY. Real values live in the vault
# (pass posthog/deploy-env) and on the box at /srv/apps/posthog/.env (0600).
# Never commit the real file.

# App image. POSTHOG_APP_IMAGE wins and pins an exact build (digest) so a
# deploy never recreates web/worker on a surprise upstream `latest`; upgrade
# deliberately by moving the pin after checking https://posthog.com/changelog.
# Fallback when unset: REGISTRY_URL + POSTHOG_APP_TAG.
POSTHOG_APP_IMAGE=posthog/posthog@sha256:<digest>
REGISTRY_URL=posthog/posthog
POSTHOG_APP_TAG=latest

# Secrets (generate with: openssl rand -base64 32)
POSTHOG_SECRET=<generated>
BROWSERLESS_SECRET=<generated>

# Served behind cloudflared (the hobby proxy terminates plain http)
TLS_BLOCK=
CADDY_TLS_BLOCK=
CADDY_HOST=http://
DOMAIN=posthog.stevens.fyi

# The proxy binds this address on the box so the tier-0 tunnel can reach it.
PROXY_BIND_IP=10.0.0.201

OPT_OUT_CAPTURE=true
TRUST_ALL_PROXIES=true
